enable
configure terminal
hostname RO-CORE-1
no ip domain lookup
banner motd ^C Unauthorized access is prohibited and prosecuted.^C

username adminCore1 privilege 15 secret 0 Ac@d3nspy_Adm!n
enable secret 0 C@mpus_L@n2026
ip domain name acadenspy.lab
crypto key generate rsa modulus 2048
ip ssh version 2

line console 0
 password C0ns0le_R0_2026
 logging synchronous
 exec-timeout 0 0
