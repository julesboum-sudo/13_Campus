enable
configure terminal
hostname DIS-AG1
no ip domain lookup
banner motd ^C Unauthorized access is prohibited and prosecuted.^C

username adminCore2 privilege 15 secret 0 Ac@d3nspy_Adm!n
enable secret 0 C@mpus_L@n2026
ip domain name acadenspy.lab
crypto key generate rsa modulus 2048
ip ssh version 2

line console 0
 password C0ns0le_R0_2026
 logging synchronous
 exec-timeout 0 0
 login 
exit

line vty 0 4
 logging synchronous
 exec-timeout 0 0
 login local
 transport input ssh
exit

snmp-server community Campus_LAN RO
access-list 10 permit 172.17.200.250
snmp-server community Campus_LAN RO 10
snmp-server location DIS-AG 
snmp-server contact julesdaroldb@gmail.com
snmp-server host 172.17.200.250 version 2c Campus_LAN

ip vrf CIN
 exit
ip vrf MSI
 exit
ip vrf AHN
 exit

vtp version 2
vtp mode server
vtp domain ACDENSPY
vtp password Campus_2026

vlan 10
 name GI
vlan 11
 name GM
vlan 12
 name GELE
vlan 13
 name GIND
vlan 14
 name GC
vlan 15
 name AHN
vlan 77
 name PARC
vlan 99
 name MGMT
vlan 100
 name NATIF
vlan 200
 name SUPERVISION
vlan 201
 name MESSAGERIE
 exit

spanning-tree mode mst
spanning-tree mst configuration
 name ACDENSPY_MST
 revision 1
 instance 1 vlan 10, 11, 12, 13, 77, 99, 200
 instance 2 vlan 14, 15, 201
 exit
spanning-tree mst 1 priority 4096
spanning-tree mst 2 priority 8192

interface Loopback0
 ip address 172.17.0.1 255.255.255.0
 ip router isis 1
 no shutdown
exit 

interface Ethernet0/0
 description INTERCO_AG-CORE-1
 no switchport
 ip address 172.17.1.22 255.255.255.252
 ip router isis 1
 no shutdown
exit

interface Ethernet0/1
 description INTERCO_AG-CORE-2
 no switchport
 ip address 172.17.1.26 255.255.255.252
 ip router isis 1
 no shutdown
exit

interface Ethernet1/3
 description TRUNK_VERS_SW-ZS-01_SUPERVISION
 switchport trunk encapsulation dot1q
 switchport mode trunk
 switchport trunk native vlan 100
 switchport trunk allowed vlan 99,200,201
 no shutdown
exit

interface range Ethernet0/2-3
 description INTERCO_DIS-AG2_LACP20
 channel-protocol pagp
 channel-group 20 mode desirable
 no shutdown
exit

interface Port-channel20
 description PO20_DIS-AG1_to_DIS-AG2_TRUNK
 switchport trunk encapsulation dot1q
 switchport mode trunk
 switchport trunk native vlan 100
 switchport trunk allowed vlan 10,11,12,13,14,15,77,99,200,201
 no shutdown
exit

interface Ethernet1/0
 description TRUNK_VERS_COM1_VRF_CIN
 switchport trunk encapsulation dot1q
 switchport mode trunk
 switchport trunk native vlan 100
 switchport trunk allowed vlan 10,11,99
 no shutdown
exit

interface Ethernet1/1
 description TRUNK_VERS_COM2_VRF_MSI
 switchport trunk encapsulation dot1q
 switchport mode trunk
 switchport trunk native vlan 100
 switchport trunk allowed vlan 12,13,99
 no shutdown
exit

interface Ethernet1/2
 description TRUNK_VERS_COM3_VRF_AHN
 switchport trunk encapsulation dot1q
 switchport mode trunk
 switchport trunk native vlan 100
 switchport trunk allowed vlan 14,15,99
 no shutdown
exit

interface Vlan10
 ip vrf forwarding CIN

 description SVI_GI_DIS-AG1
 ip address 192.168.10.1 255.255.255.0
 vrrp 10 ip 192.168.10.254
 vrrp 10 priority 150 
 vrrp 10 preempt 

 ip helper-address global 172.17.99.12
 ip helper-address global 172.17.99.13
 no shutdown
exit

interface Vlan11
 ip vrf forwarding CIN
 
 description SVI_GM_DIS-AG1
 ip address 192.168.11.1 255.255.255.0
 vrrp 11 ip 192.168.11.254
 vrrp 11 priority 150 
 vrrp 11 preempt 

 ip helper-address global 172.17.99.12
 ip helper-address global 172.17.99.13
 no shutdown
exit

interface Vlan12
 ip vrf forwarding MSI

 description SVI_GELE_DIS-AG1
 ip address 192.168.12.1 255.255.255.0
 vrrp 12 ip 192.168.12.254
 vrrp 12 priority 150 
 vrrp 12 preempt 

 ip helper-address global 172.17.99.12
 ip helper-address global 172.17.99.13
 no shutdown
exit

interface Vlan13
 ip vrf forwarding MSI

 description SVI_GIND_DIS-AG1
 ip address 192.168.13.1 255.255.255.0
 vrrp 13 ip 192.168.13.254

 ip helper-address global 172.17.99.12
 ip helper-address global 172.17.99.13
 no shutdown
exit

interface Vlan14
 ip vrf forwarding AHN

 description SVI_GC_DIS-AG1
 ip address 192.168.14.1 255.255.255.0
 vrrp 14 ip 192.168.14.254

 ip helper-address global 172.17.99.12
 ip helper-address global 172.17.99.13
 no shutdown
exit

interface Vlan15
 ip vrf forwarding AHN

 description SVI_AHN_DIS-AG1
 ip address 192.168.15.1 255.255.255.0
 vrrp 15 ip 192.168.15.254

 ip helper-address global 172.17.99.12
 ip helper-address global 172.17.99.13
 no shutdown
exit

interface Vlan99
 description Management_VLAN
 ip address 192.168.99.1 255.255.255.0
 vrrp 99 ip 192.168.99.254
 ip router isis 1
 no shutdown
exit

interface Vlan200
 description SVI_SUPERVISION
 ip address 172.17.200.254 255.255.255.0
 ip router isis 1
 no shutdown
exit

ip routing
router isis 1
 net 49.0001.0000.0000.0005.00
 is-type level-2-only
 log-adjacency-changes
 redistribute static ip
 exit



ip route 192.168.10.0 255.255.255.0 Vlan10
ip route 192.168.11.0 255.255.255.0 Vlan11
ip route 192.168.12.0 255.255.255.0 Vlan12
ip route 192.168.13.0 255.255.255.0 Vlan13
ip route 192.168.14.0 255.255.255.0 Vlan14
ip route 192.168.15.0 255.255.255.0 Vlan15

ip route vrf CIN 0.0.0.0 0.0.0.0 172.17.1.21 global
ip route vrf CIN 0.0.0.0 0.0.0.0 172.17.1.25 global 10

ip route vrf MSI 0.0.0.0 0.0.0.0 172.17.1.21 global
ip route vrf MSI 0.0.0.0 0.0.0.0 172.17.1.25 global 10

ip route vrf AHN 0.0.0.0 0.0.0.0 172.17.1.21 global
ip route vrf AHN 0.0.0.0 0.0.0.0 172.17.1.25 global 10

ip route vrf CIN 172.17.200.0 255.255.255.0 172.17.200.250 global
ip route vrf CIN 172.17.201.0 255.255.255.0 172.17.201.250 global

ip route vrf MSI 172.17.200.0 255.255.255.0 172.17.200.250 global
ip route vrf MSI 172.17.201.0 255.255.255.0 172.17.201.250 global

ip route vrf AHN 172.17.200.0 255.255.255.0 172.17.200.250 global
ip route vrf AHN 172.17.201.0 255.255.255.0 172.17.201.250 global


do copy run start