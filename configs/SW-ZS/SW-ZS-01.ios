enable
configure terminal
hostname SW-ZS-01
no ip domain lookup
banner motd ^C Unauthorized access is prohibited and prosecuted.^C

username adminCore2 privilege 15 secret 0 Ac@d3nspy_Adm!n
enable secret 0 C@mpus_L@n2026
ip domain name acadenspy.lab
crypto key generate rsa modulus 2048
ip ssh version 2

line console 0
 password C0ns0le_R0_2026
 logging synchronous
 exec-timeout 0 0
 login 
exit

line vty 0 4
 logging synchronous
 exec-timeout 0 0
 login local
 transport input ssh
exit

snmp-server community Campus_LAN RO
access-list 10 permit 172.17.200.250
snmp-server community Campus_LAN RO 10
snmp-server location Serveur
snmp-server contact julesdaroldb@gmail.com
snmp-server host 172.17.200.250 version 2c Campus_LAN

vtp version 2
vtp mode transparent
vtp domain ACDENSPY

vlan 10
 name GI
vlan 11
 name GM
vlan 12
 name GELE
vlan 13
 name GIND
vlan 14
 name GC
vlan 15
 name AHN
vlan 77
 name PARC
vlan 99
 name MGMT
vlan 100
 name NATIF
vlan 200
 name SUPERVISION
vlan 201
 name MESSAGERIE
 exit  

spanning-tree mode mst
spanning-tree mst configuration
 name ACDENSPY_MST
 revision 1
 instance 1 vlan 10, 11, 12, 13, 77, 99, 200
 instance 2 vlan 14, 15, 201
 exit

interface Vlan99
 description SVI_MGMT_sw-zs-01
 ip address 192.168.99.6 255.255.255.0
 no shutdown
exit

ip default-gateway 192.168.99.254

interface Ethernet0/1
 description TRUNK_VERS_DIS-AG1
 switchport trunk encapsulation dot1q
 switchport mode trunk
 switchport trunk native vlan 100
 switchport trunk allowed vlan 99,200,201
 no shutdown
exit

interface Ethernet0/0
 description ACCES_SUPERVISION_LIBRENMS
 switchport mode access
 switchport access vlan 200
 switchport nonegotiate
 spanning-tree portfast
 spanning-tree bpduguard enable
 switchport port-security
 switchport port-security maximum 2
 switchport port-security mac-address sticky
 switchport port-security violation restrict
 no shutdown
exit

int range e0/2-3, e1/0-3
 switchport mode access
  switchport access vlan 77
  shutdown
  exit

do copy run start